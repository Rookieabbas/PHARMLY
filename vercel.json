{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/medicines",
      "destination": "/api/index.js"
    },
    {
      "source": "/medicine/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/medicine",
      "destination": "/api/index.js"
    },
    {
      "source": "/search",
      "destination": "/api/index.js"
    },
    {
      "source": "/expired-medicines",
      "destination": "/api/index.js"
    },
    {
      "source": "/low-stock",
      "destination": "/api/index.js"
    },
    {
      "source": "/sell/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
